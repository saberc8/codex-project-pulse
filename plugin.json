{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-project-pulse",
  "version": "0.2.1",
  "description": "A desktop plugin for project activity, unread results, and linked todos across Codex, Claude Code and magpie sessions.",
  "author": {
    "name": "saber",
    "url": "https://github.com/saberc8"
  },
  "keywords": [
    "codex",
    "projects",
    "dashboard",
    "todos"
  ],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Project Pulse · 项目总控台",
        "shortDescription": "Codex 插件：项目进展、未读与待办",
        "longDescription": "Codex 项目管理插件：集中查看各项目的进行中会话和完成未读结果，管理绑定项目或会话的待办，点击回到原对话。项目与待办数据保存在本机。",
        "developerName": "saber",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "brandColor": "#202020",
        "defaultPrompt": [
          "打开项目总控台",
          "看看哪些项目有未读结果",
          "给当前项目添加一个待办"
        ],
        "composerIcon": "./assets/icon-outline.svg",
        "logo": "./assets/logo.png",
        "composerIconDark": "./assets/icon-outline-dark.svg",
        "logoDark": "./assets/icon-solid-dark.svg"
      }
    }
  },
  "homepage": "https://github.com/saberc8/codex-project-pulse",
  "repository": "https://github.com/saberc8/codex-project-pulse",
  "license": "MIT"
}
